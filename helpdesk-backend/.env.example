# ---------------------------------------------------------------
# INSA Helpdesk — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to git.
# ---------------------------------------------------------------

# Server
# NOTE: The backend runs on port 8085 (not 8080).
# Port 8080 was in use on the dev machine — 8085 is the standard for this project.
SERVER_PORT=8085

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insa_helpdesk
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# Frontend base URL (used in password-reset emails)
FRONTEND_BASE_URL=http://localhost:3000

# Mail (optional — uses Mailtrap sandbox by default)
# Sign up free at https://mailtrap.io to get real test credentials.
# Without real credentials, email sending fails silently (app still works).
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM=noreply@insa-helpdesk.local
